{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Window controls, settings events, and file selection for standalone settings",
  "windows": ["settings"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "dialog:allow-open"
  ]
}
